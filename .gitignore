# Runtime data - generated on first run, contains site-specific config and password hashes
flask-server/users.json
flask-server/buildings.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# Arduino build artifacts
*.bin
build/

# EXCEPT the published firmware release binaries - these ARE meant to be
# committed (build_and_release_firmware.ps1 publishes here, and the ESP32's
# own OTA check + the website's "auto-update outdated devices" feature both
# depend on these actually being in the repo).
!firmware/firmware.bin
!firmware/releases/*.bin

# PyInstaller build output - compiled binaries are published via GitHub
# Releases instead of being committed here (keeps repo size sane, and
# Releases page is the natural place users look for a download anyway)
tools/dist/
tools/build/
*.spec.bak
